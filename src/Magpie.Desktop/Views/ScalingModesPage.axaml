<!-- ScalingModesPage.xaml port; initial mode/effect names follow AppSettings::_SetInitialSettings. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Magpie.Desktop.Controls" x:Class="Magpie.Desktop.Views.ScalingModesPage">
<c:PageFrame Title="{c:Loc ScalingModes_PageFrame.Title}">
<c:PageFrame.HeaderAction><Button Classes="subtle" ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="18" Height="18" /><Button.Flyout><MenuFlyout><MenuItem Name="ExportModesAction" Header="{c:Loc ScalingModes_General_Export.Text}" Click="ExportModes_Click"><MenuItem.Icon><c:SymbolIcon Kind="Export" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Name="ImportModesAction" Header="{c:Loc ScalingModes_General_Import.Text}" Click="ImportModes_Click"><MenuItem.Icon><c:SymbolIcon Kind="Import" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button></c:PageFrame.HeaderAction>
<StackPanel Spacing="2" Margin="0,4,0,0">
<TextBlock Name="InterchangeStatus" IsVisible="False" TextWrapping="Wrap" Margin="0,0,0,12" /><StackPanel Name="CustomModes" Spacing="2" />
<c:SettingsExpander Header="Lanczos" Description="Lanczos">
<c:SettingsExpander.Action><StackPanel Orientation="Horizontal" Spacing="4">
<Button ToolTip.Tip="Rename"><c:SymbolIcon Kind="Edit" Width="15" Height="15" /><Button.Flyout><Flyout><c:RenameFlyoutContent Value="Lanczos" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="15" Height="15" /><Button.Flyout><MenuFlyout><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveUp.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronUp" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveDown.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronDown" Width="16" Height="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{c:Loc Profile_MoreOptions_Delete.Text}" Click="DeleteMode_Click" Tag="Lanczos"><MenuItem.Icon><c:SymbolIcon Kind="Delete" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button>
</StackPanel></c:SettingsExpander.Action>
<StackPanel Spacing="0">
<c:SettingsCard Header="Lanczos" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4"><Button ToolTip.Tip="Scale"><c:SymbolIcon Kind="Scale" Width="15" Height="15" /><Button.Flyout><Flyout><c:ScaleFlyoutContent Name="LanczosScale" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="Parameters"><c:SymbolIcon Kind="Settings" Width="15" Height="15" /><Button.Flyout><Flyout><ScrollViewer MaxHeight="450"><StackPanel Width="260" Spacing="8"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Anti-ringing Strength" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter0.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter0" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.01" /></StackPanel></StackPanel></ScrollViewer></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="" Description=""><Button Classes="subtle" Content="+  Add effect"><Button.Flyout><Flyout><StackPanel Width="280" Spacing="12"><TextBox PlaceholderText="Search effects" /><ListBox><ListBoxItem Content="Lanczos" /><ListBoxItem Content="FSR_EASU" /><ListBoxItem Content="FSR_RCAS" /><ListBoxItem Content="Anime4K_Upscale_Denoise_L" /><ListBoxItem Content="Nearest" /></ListBox></StackPanel></Flyout></Button.Flyout></Button></c:SettingsCard>
</StackPanel></c:SettingsExpander>
<c:SettingsExpander Header="FSR" Description="FSR_EASU &gt; FSR_RCAS">
<c:SettingsExpander.Action><StackPanel Orientation="Horizontal" Spacing="4">
<Button Name="UseFsrMode" Content="{c:Loc Desktop.Use}" Click="UseFsr_Click" />
<Button ToolTip.Tip="Rename"><c:SymbolIcon Kind="Edit" Width="15" Height="15" /><Button.Flyout><Flyout><c:RenameFlyoutContent Value="FSR" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="15" Height="15" /><Button.Flyout><MenuFlyout><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveUp.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronUp" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveDown.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronDown" Width="16" Height="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{c:Loc Profile_MoreOptions_Delete.Text}" Click="DeleteMode_Click" Tag="FSR"><MenuItem.Icon><c:SymbolIcon Kind="Delete" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button>
</StackPanel></c:SettingsExpander.Action>
<StackPanel Spacing="0">
<c:SettingsCard Header="FSR_EASU" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4"><Button ToolTip.Tip="Scale"><c:SymbolIcon Kind="Scale" Width="15" Height="15" /><Button.Flyout><Flyout><c:ScaleFlyoutContent /></Flyout></Button.Flyout></Button>

<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="FSR_RCAS" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4">
<Button ToolTip.Tip="Parameters"><c:SymbolIcon Kind="Settings" Width="15" Height="15" /><Button.Flyout><Flyout><ScrollViewer MaxHeight="450"><StackPanel Width="260" Spacing="8"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Sharpness" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter1.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter1" Minimum="0" Maximum="1" Value="0.87" SmallChange="0.01" /></StackPanel></StackPanel></ScrollViewer></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="" Description=""><Button Classes="subtle" Content="+  Add effect"><Button.Flyout><Flyout><StackPanel Width="280" Spacing="12"><TextBox PlaceholderText="Search effects" /><ListBox><ListBoxItem Content="Lanczos" /><ListBoxItem Content="FSR_EASU" /><ListBoxItem Content="FSR_RCAS" /><ListBoxItem Content="Anime4K_Upscale_Denoise_L" /><ListBoxItem Content="Nearest" /></ListBox></StackPanel></Flyout></Button.Flyout></Button></c:SettingsCard>
</StackPanel></c:SettingsExpander>
<c:SettingsExpander Header="FSRCNNX" Description="FSRCNNX">
<c:SettingsExpander.Action><StackPanel Orientation="Horizontal" Spacing="4"><Button Name="UseFsrcnnxMode" Content="{c:Loc Desktop.Use}" Click="UseFsrcnnx_Click" />
<Button ToolTip.Tip="Rename"><c:SymbolIcon Kind="Edit" Width="15" Height="15" /><Button.Flyout><Flyout><c:RenameFlyoutContent Value="FSRCNNX" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="15" Height="15" /><Button.Flyout><MenuFlyout><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveUp.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronUp" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveDown.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronDown" Width="16" Height="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{c:Loc Profile_MoreOptions_Delete.Text}" Click="DeleteMode_Click" Tag="FSRCNNX"><MenuItem.Icon><c:SymbolIcon Kind="Delete" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button>
</StackPanel></c:SettingsExpander.Action>
<StackPanel Spacing="0">
<c:SettingsCard Header="FSRCNNX" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4">

<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="" Description=""><Button Classes="subtle" Content="+  Add effect"><Button.Flyout><Flyout><StackPanel Width="280" Spacing="12"><TextBox PlaceholderText="Search effects" /><ListBox><ListBoxItem Content="Lanczos" /><ListBoxItem Content="FSR_EASU" /><ListBoxItem Content="FSR_RCAS" /><ListBoxItem Content="Anime4K_Upscale_Denoise_L" /><ListBoxItem Content="Nearest" /></ListBox></StackPanel></Flyout></Button.Flyout></Button></c:SettingsCard>
</StackPanel></c:SettingsExpander>
<c:SettingsExpander Header="CuNNy" Description="CuNNy-4x12-NVL">
<c:SettingsExpander.Action><StackPanel Orientation="Horizontal" Spacing="4">
<Button ToolTip.Tip="Rename"><c:SymbolIcon Kind="Edit" Width="15" Height="15" /><Button.Flyout><Flyout><c:RenameFlyoutContent Value="CuNNy" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="15" Height="15" /><Button.Flyout><MenuFlyout><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveUp.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronUp" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveDown.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronDown" Width="16" Height="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{c:Loc Profile_MoreOptions_Delete.Text}" Click="DeleteMode_Click" Tag="CuNNy"><MenuItem.Icon><c:SymbolIcon Kind="Delete" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button>
</StackPanel></c:SettingsExpander.Action>
<StackPanel Spacing="0">
<c:SettingsCard Header="CuNNy-4x12-NVL" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4"><Button Name="UseCunnyMode" Content="{c:Loc Desktop.Use}" Click="UseCunny_Click" />

<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="" Description=""><Button Classes="subtle" Content="+  Add effect"><Button.Flyout><Flyout><StackPanel Width="280" Spacing="12"><TextBox PlaceholderText="Search effects" /><ListBox><ListBoxItem Content="Lanczos" /><ListBoxItem Content="FSR_EASU" /><ListBoxItem Content="FSR_RCAS" /><ListBoxItem Content="Anime4K_Upscale_Denoise_L" /><ListBoxItem Content="Nearest" /></ListBox></StackPanel></Flyout></Button.Flyout></Button></c:SettingsCard>
</StackPanel></c:SettingsExpander>
<c:SettingsExpander Header="Anime4K" Description="Anime4K_Upscale_Denoise_L">
<c:SettingsExpander.Action><StackPanel Orientation="Horizontal" Spacing="4"><Button Name="UseAnimeMode" Content="{c:Loc Desktop.Use}" Click="UseAnime4K_Click" />
<Button ToolTip.Tip="Rename"><c:SymbolIcon Kind="Edit" Width="15" Height="15" /><Button.Flyout><Flyout><c:RenameFlyoutContent Value="Anime4K" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="15" Height="15" /><Button.Flyout><MenuFlyout><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveUp.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronUp" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveDown.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronDown" Width="16" Height="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{c:Loc Profile_MoreOptions_Delete.Text}" Click="DeleteMode_Click" Tag="Anime4K"><MenuItem.Icon><c:SymbolIcon Kind="Delete" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button>
</StackPanel></c:SettingsExpander.Action>
<StackPanel Spacing="0">
<c:SettingsCard Header="Anime4K_Upscale_Denoise_L" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4">

<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="" Description=""><Button Classes="subtle" Content="+  Add effect"><Button.Flyout><Flyout><StackPanel Width="280" Spacing="12"><TextBox PlaceholderText="Search effects" /><ListBox><ListBoxItem Content="Lanczos" /><ListBoxItem Content="FSR_EASU" /><ListBoxItem Content="FSR_RCAS" /><ListBoxItem Content="Anime4K_Upscale_Denoise_L" /><ListBoxItem Content="Nearest" /></ListBox></StackPanel></Flyout></Button.Flyout></Button></c:SettingsCard>
</StackPanel></c:SettingsExpander>
<c:SettingsExpander Header="CRT-Geom" Description="CRT_Geom">
<c:SettingsExpander.Action><StackPanel Orientation="Horizontal" Spacing="4"><Button Name="UseCrtMode" Content="{c:Loc Desktop.Use}" Click="UseCrt_Click" />
<Button ToolTip.Tip="Rename"><c:SymbolIcon Kind="Edit" Width="15" Height="15" /><Button.Flyout><Flyout><c:RenameFlyoutContent Value="CRT-Geom" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="15" Height="15" /><Button.Flyout><MenuFlyout><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveUp.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronUp" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveDown.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronDown" Width="16" Height="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{c:Loc Profile_MoreOptions_Delete.Text}" Click="DeleteMode_Click" Tag="CRT-Geom"><MenuItem.Icon><c:SymbolIcon Kind="Delete" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button>
</StackPanel></c:SettingsExpander.Action>
<StackPanel Spacing="0">
<c:SettingsCard Header="CRT_Geom" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4"><Button ToolTip.Tip="Scale"><c:SymbolIcon Kind="Scale" Width="15" Height="15" /><Button.Flyout><Flyout><c:ScaleFlyoutContent /></Flyout></Button.Flyout></Button>
<Button Name="CrtParametersButton" ToolTip.Tip="Parameters"><c:SymbolIcon Kind="Settings" Width="15" Height="15" /><Button.Flyout><Flyout><ScrollViewer MaxHeight="450"><StackPanel Width="260" Spacing="8"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Target Gamma" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter2.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter2" Minimum="0.1" Maximum="5" Value="1.5" SmallChange="0.01" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Monitor Gamma" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter3.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter3" Minimum="0.1" Maximum="5" Value="2.2" SmallChange="0.01" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Distance" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter4.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter4" Minimum="0.1" Maximum="3.0" Value="1.5" SmallChange="0.01" /></StackPanel><CheckBox Name="CrtCurvature" Content="Curvature" IsChecked="True" /><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Curvature Radius" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter5.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter5" Minimum="0.1" Maximum="10" Value="2" SmallChange="0.1" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Corner Size" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter6.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter6" Minimum="0" Maximum="1.0" Value="0.001" SmallChange="0.01" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Corner Smoothness" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter7.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter7" Minimum="80" Maximum="2000" Value="1000" SmallChange="1" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Horizontal Tilt" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter8.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter8" Minimum="-0.5" Maximum="0.5" Value="0" SmallChange="0.01" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Vertical Tilt" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter9.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter9" Minimum="-0.5" Maximum="0.5" Value="0" SmallChange="0.01" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Horizontal Overscan" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter10.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter10" Minimum="-125" Maximum="125" Value="100" SmallChange="1" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Vertical Overscan" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter11.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter11" Minimum="-125" Maximum="125" Value="100" SmallChange="1" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Dot Mask" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter12.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter12" Minimum="0" Maximum="0.3" Value="0.3" SmallChange="0.01" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Sharpness" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter13.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter13" Minimum="1" Maximum="3" Value="1" SmallChange="1" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Scanline Weight" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter14.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter14" Minimum="0.1" Maximum="0.5" Value="0.3" SmallChange="0.01" /></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Luminance Boost" /><TextBlock Grid.Column="1" Text="{Binding #EffectParameter15.Value, StringFormat={}{0:0.##}}" /></Grid><Slider Name="EffectParameter15" Minimum="0" Maximum="1" Value="0" SmallChange="0.01" /></StackPanel></StackPanel></ScrollViewer></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="" Description=""><Button Classes="subtle" Content="+  Add effect"><Button.Flyout><Flyout><StackPanel Width="280" Spacing="12"><TextBox PlaceholderText="Search effects" /><ListBox><ListBoxItem Content="Lanczos" /><ListBoxItem Content="FSR_EASU" /><ListBoxItem Content="FSR_RCAS" /><ListBoxItem Content="Anime4K_Upscale_Denoise_L" /><ListBoxItem Content="Nearest" /></ListBox></StackPanel></Flyout></Button.Flyout></Button></c:SettingsCard>
</StackPanel></c:SettingsExpander>
<c:SettingsExpander Header="Integer Scale 2x" Description="Nearest">
<c:SettingsExpander.Action><StackPanel Orientation="Horizontal" Spacing="4">
<Button ToolTip.Tip="Rename"><c:SymbolIcon Kind="Edit" Width="15" Height="15" /><Button.Flyout><Flyout><c:RenameFlyoutContent Value="Integer Scale 2x" /></Flyout></Button.Flyout></Button>
<Button ToolTip.Tip="More options"><c:SymbolIcon Kind="More" Width="15" Height="15" /><Button.Flyout><MenuFlyout><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveUp.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronUp" Width="16" Height="16" /></MenuItem.Icon></MenuItem><MenuItem Header="{c:Loc ScalingModes_MoreOptionsFlyout_MoveDown.Text}"><MenuItem.Icon><c:SymbolIcon Kind="ChevronDown" Width="16" Height="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{c:Loc Profile_MoreOptions_Delete.Text}" Click="DeleteMode_Click" Tag="Integer Scale 2x"><MenuItem.Icon><c:SymbolIcon Kind="Delete" Width="16" Height="16" /></MenuItem.Icon></MenuItem></MenuFlyout></Button.Flyout></Button>
</StackPanel></c:SettingsExpander.Action>
<StackPanel Spacing="0">
<c:SettingsCard Header="Nearest" Classes="effect"><StackPanel Orientation="Horizontal" Spacing="4"><Button ToolTip.Tip="Scale"><c:SymbolIcon Kind="Scale" Width="15" Height="15" /><Button.Flyout><Flyout><c:ScaleFlyoutContent /></Flyout></Button.Flyout></Button>

<Button ToolTip.Tip="Delete"><c:SymbolIcon Kind="Delete" Width="15" Height="15" /></Button>
<Button ToolTip.Tip="Move up"><c:SymbolIcon Kind="ChevronUp" Width="15" Height="15" /></Button><Button ToolTip.Tip="Move down"><c:SymbolIcon Kind="ChevronDown" Width="15" Height="15" /></Button>
</StackPanel></c:SettingsCard>
<c:SettingsCard Header="" Description=""><Button Classes="subtle" Content="+  Add effect"><Button.Flyout><Flyout><StackPanel Width="280" Spacing="12"><TextBox PlaceholderText="Search effects" /><ListBox><ListBoxItem Content="Lanczos" /><ListBoxItem Content="FSR_EASU" /><ListBoxItem Content="FSR_RCAS" /><ListBoxItem Content="Anime4K_Upscale_Denoise_L" /><ListBoxItem Content="Nearest" /></ListBox></StackPanel></Flyout></Button.Flyout></Button></c:SettingsCard>
</StackPanel></c:SettingsExpander>
<Button Name="NewScalingModeButton" Content="+  New scaling mode" Classes="accent" HorizontalAlignment="Right" Margin="0,20,0,16">
<Button.Flyout><Flyout Placement="Left"><c:NewScalingModeFlyoutContent Name="NewModeForm" /></Flyout></Button.Flyout></Button>
</StackPanel></c:PageFrame></UserControl>
