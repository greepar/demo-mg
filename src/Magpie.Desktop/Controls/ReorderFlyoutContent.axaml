<!-- ProfilePage.xaml: ReorderFlyout port. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Magpie.Desktop.Controls"
             x:Class="Magpie.Desktop.Controls.ReorderFlyoutContent">
  <StackPanel>
    <TextBlock Text="{c:Loc Profile_MoreOptions_ReorderFlyout_Title.Text}" />
    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center" Spacing="4">
      <Button Name="MoveUpButton" Click="MoveUp_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><c:SymbolIcon Kind="ChevronUp" Width="14" Height="14" VerticalAlignment="Center" /><TextBlock Text="{c:Loc Profile_MoreOptions_ReorderFlyout_MoveUp.Text}" /></StackPanel></Button>
      <Button Name="MoveDownButton" Click="MoveDown_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><c:SymbolIcon Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" /><TextBlock Text="{c:Loc Profile_MoreOptions_ReorderFlyout_MoveDown.Text}" /></StackPanel></Button>
    </StackPanel>
  </StackPanel>
</UserControl>
