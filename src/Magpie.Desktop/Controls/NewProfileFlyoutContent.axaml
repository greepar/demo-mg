<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Magpie.Desktop.Controls" x:Class="Magpie.Desktop.Controls.NewProfileFlyoutContent">
  <StackPanel Name="CandidateForm" Width="310" Spacing="12">
    <TextBlock Text="{c:Loc Root_NewProfileFlyout_Title.Text}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,8" />
    <StackPanel Name="WindowsSources" Spacing="8" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox Name="CandidateWindows" PlaceholderText="{c:Loc Root_NewProfileFlyout_ComboBox.PlaceholderText}" SelectionChanged="Window_SelectionChanged" HorizontalAlignment="Stretch" />
        <Button Grid.Column="1" Content="{c:Loc Desktop.Refresh}" Click="Refresh_Click" Margin="8,0,0,0" />
      </Grid>
      <ProgressBar Name="CandidatesLoading" IsIndeterminate="True" IsVisible="False" Height="3" />
      <TextBlock Name="NoCandidates" Text="{c:Loc Root_NewProfileFlyout_NoCandidateWindow.Text}" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
    <StackPanel Name="ExecutableFields" Spacing="8">
      <TextBlock Text="Executable" />
      <Grid ColumnDefinitions="*,Auto"><TextBox Name="ExecutableInput" TextChanged="Input_Changed" MaxLength="4096" /><Button Grid.Column="1" Content="Browse" Click="Browse_Click" Margin="8,0,0,0" /></Grid>
    </StackPanel>
    <StackPanel Name="ProfileFields" Spacing="12">
      <TextBlock Text="{c:Loc Root_NewProfileFlyout_Name.Text}" /><TextBox Name="NameInput" TextChanged="Input_Changed" MaxLength="128" />
      <TextBlock Text="{c:Loc Root_NewProfileFlyout_CopyFrom.Text}" /><ComboBox Name="CopySource" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="{c:Loc Root_Defaults.Content}" /></ComboBox>
      <Button Name="CreateButton" Content="{c:Loc Root_NewProfileFlyout_Create.Content}" Classes="accent" IsEnabled="False" HorizontalAlignment="Right" Click="Create_Click" />
    </StackPanel>
    <TextBlock Name="ErrorText" IsVisible="False" Foreground="#C42B1C" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
