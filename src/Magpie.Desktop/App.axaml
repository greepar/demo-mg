<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Magpie.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ComboBoxDropDownBackground">#FCFCFC</SolidColorBrush>
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#1F000000</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ComboBoxDropDownBackground">#2C2C2C</SolidColorBrush>
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#66000000</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="ContentControlThemeFontFamily">avares://Magpie.Desktop/Assets/Fonts#Selawik</FontFamily>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0067C0" />
        <ColorPaletteResources x:Key="Dark" Accent="#60CDFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Magpie.Desktop/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
